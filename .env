# Committed defaults — public, non-secret. Secrets belong in .env.local, which
# is gitignored. Vite inlines all of these at BUILD time.

# Absolute origin, used to build Open Graph / Twitter urls in index.html.
# Relative og:image paths are dropped by every link-preview scraper, so this has
# to be a full origin. No trailing slash. Override as a Railway build variable
# if the site lands on a different domain.
VITE_SITE_URL=https://180peakperformance.com
