# Copy to .env.local for local dev, and set the same keys as Railway variables.
# Vite inlines these at build time, so changing one on Railway needs a redeploy.

# Nate's Calendly scheduling link. This is what turns the page's CTAs on —
# without it every book button hides itself and the page has no conversion path.
# e.g. https://calendly.com/nate-180peak/consult
VITE_CALENDLY_URL=

# Fallback if there's no Calendly yet — book buttons become a mailto instead.
VITE_CONTACT_EMAIL=
