# Railway injects $PORT and routes to it. Binding a fixed port is the usual
# reason a first deploy comes back "no healthy upstream".
:{$PORT:80} {
	# /srv is where the Dockerfile puts dist. Overridable so this exact config
	# can be exercised locally against ./dist before a deploy:
	#   npm run build && PORT=8099 SITE_ROOT=./dist caddy run --config Caddyfile
	root * {$SITE_ROOT:/srv}
	encode zstd gzip

	# Vite fingerprints everything under /assets, so it can be cached forever.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Clips and posters are stable but not fingerprinted — a month is plenty,
	# and re-running the asset script changes the filename only if the id does.
	@media path /clips/*
	header @media Cache-Control "public, max-age=2592000"

	# The entry point must never be cached, or a deploy won't reach anyone
	# holding a stale copy that references deleted asset hashes.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Single page app: unknown paths fall back to the shell rather than 404.
	try_files {path} /index.html
	file_server
}
